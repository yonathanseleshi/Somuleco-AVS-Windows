<Page
    x:Class="Somuleco_AVS.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackgroundBrush}">
    <NavigationView x:Name="AppNavigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.Header>
            <CommandBar DefaultLabelPosition="Right" HorizontalContentAlignment="Stretch">
                <AppBarButton Label="New project" Click="OnNewProjectClick" />
                <AppBarButton Label="Record" Click="OnRecordClick" />
                <AppBarButton Label="Import media" Click="OnImportMediaClick" />
                <AppBarButton Label="Processing" Click="OnProcessingClick" />
            </CommandBar>
        </NavigationView.Header>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home" />
            <NavigationViewItem Content="Projects" Tag="Projects" />
            <NavigationViewItem Content="Studio" Tag="Studio" />
            <NavigationViewItem Content="Editor" Tag="Editor" />
            <NavigationViewItem Content="Clips" Tag="Clips" />
            <NavigationViewItem Content="Create" Tag="Create" />
            <NavigationViewItem Content="Library" Tag="Library" />
            <NavigationViewItem Content="Live" Tag="Live" />
            <NavigationViewItem Content="Meet" Tag="Meet" />
            <NavigationViewItem Content="Podcasts" Tag="Podcasts" />
            <NavigationViewItem Content="Publish" Tag="Publish" />
            <NavigationViewItem Content="Processing" Tag="Processing" />
            <NavigationViewItem Content="Analytics" Tag="Analytics" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="WorkspaceFrame" />
    </NavigationView>
</Page>